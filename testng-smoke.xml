
<suite name="Amazon Smoke Suite">

    <listeners>
        <listener class-name="com.company.projects.listeners.TestListener"/>
    </listeners>

    <!-- Block 1: Fast API Tests -->
    <test name="API Performance Tests">
        <groups>
            <run>
            <include name="api"/></run>
        </groups>
        <classes>
            <class name="com.company.project.api.tests.UserApiTest"/>
        </classes>
    </test>

    <!-- Block 2: Slower Selenium UI Tests -->
    <test name="UI Functional Tests">
        <groups>
            <run><include name="ui"/></run>
        </groups>
        <classes>
            <class name="com.company.project.ui.tests.LoginTest"/>
        </classes>
    </test>

</suite>
