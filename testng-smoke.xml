<?xml version="1.0" encoding="UTF-8"?>

<suite name="Amazon Smoke Suite">

    <listeners>
        <listener class-name="com.company.projects.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
             <class name="com.company.project.tests.LoginTest"/>

            <class name="com.company.project.tests.LogOutTest"/>
        </classes>

    </test>

</suite>